# Valeurs vides. Aucun secret. Noms du cahier, plus trois champs
# d'identité réglementaire. Rien ici n'est une convention Ops vérifiée.
# Le domaine canonique est https://maisonsquebec.ca — pas le singulier.

SITE_URL=https://maisonsquebec.ca

# Identité professionnelle. Laisser vide tant que la donnée n'est pas vérifiée.
BROKER_OACIQ_PERMIT=
AGENCY_NAME=
AGENCY_PERMIT=

# Session admin. Vide = aucune session acceptée. Pas un fournisseur d'identité.
ADMIN_SESSION_SECRET=

# Compte d'amorçage. Valeurs volontairement vides : aucun mot de passe dans le dépôt.
# Le TOTP n'est exigé que si ADMIN_TOTP_SECRET contient un secret base32.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_TOTP_SECRET=

# SQLite locale des paramètres du site. Vide = data/site-settings.sqlite
# Remplaçable. Ce n'est pas la base Postgres du cahier.
SITE_SETTINGS_PATH=

# Base. Non utilisée dans cette fondation. Ne pas inventer une URL.
DATABASE_URL=

# Studio éditorial. Clé vide. Le connecteur n'est pas branché.
OPENROUTER_API_KEY=
EDITORIAL_AI_ENABLED=
EDITORIAL_AI_DEFAULT_MODEL=
EDITORIAL_AI_DAILY_BUDGET_USD=

# Images. Clés vides : /admin/medias affiche « à connecter », n'appelle rien et n'enregistre aucune image.
# Un fichier déposé par le propriétaire ou l'éditeur va dans data/media (ignoré par git), seulement si la fiche a une licence, un auteur et une source.
# MEDIA_DIR vide = data/media.
IMAGE_GENERATION_ENABLED=
IMAGE_GENERATION_PROVIDER=
IMAGE_GENERATION_MODEL=
IMAGE_GENERATION_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Webhooks sortants. Non implémentés. Secret vide.
WEBHOOKS_ENABLED=
WEBHOOK_DEFAULT_TIMEOUT_MS=
WEBHOOK_SIGNING_SECRET=

# Automatisations. Moteur non choisi. N8N_BASE_URL vide : l'admin affiche « à connecter » et n'appelle rien.
AUTOMATIONS_ENABLED=
AUTOMATIONS_ENGINE=
N8N_BASE_URL=
N8N_API_KEY=

# Analytique et rapports. Non branchés. Noms provisoires pour Search Console,
# Bing et le stockage, le cahier ne fixant pas ces identifiants.
ANALYTICS_ENABLED=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
BING_WEBMASTER_API_KEY=
REPORT_EXPORTS_ENABLED=
JOBS_ENABLED=
STORAGE_BUCKET=
